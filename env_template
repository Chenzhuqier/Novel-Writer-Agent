# ============================================================
# Novel-Writer-Agent LLM 配置文件
# ============================================================
# 复制此文件为 .env 后，根据你的服务商填写下方配置
# 项目启动时会自动加载此文件（通过 python-dotenv）
#
# 📌 使用方法：
#   1. 取消你需要的服务商配置的注释
#   2. 填入你的 API Key
#   3. 保存后运行 python app.py
# ============================================================

# ----------------------------------------------------------
# 必填：API Key（三选一填入即可）
# ----------------------------------------------------------

OPENAI_API_KEY=sk-your-key-here


# ----------------------------------------------------------
# 可选：API 地址和模型配置
# ----------------------------------------------------------

# API 地址（默认 OpenAI 官方）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 主力模型（默认 gpt-4o-mini）
# LLM_MODEL=gpt-4o-mini

# 备用模型（主力模型失败时自动切换）
# LLM_FALLBACK_MODEL=gpt-4o-mini

# 可选：语义检索（RAG）——默认关闭，开启需先安装向量依赖
# ENABLE_VECTOR=off
# VECTOR_MODEL=BAAI/bge-small-zh-v1.5
#
# 安装方式（首次会联网下载模型，约 100MB）：
#   pip install -r requirements-rag.txt


